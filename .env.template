# --- Auth-System Environment Configuration ---
# This file contains all environment variables for the auth system
# Copy this to .env and fill in your values

# =============================================================================
# ENVIRONMENT
# =============================================================================
NODE_ENV=development

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Development
DEV_FRONTEND_PORT=3000
DEV_FRONTEND_HOST=localhost

# Production
PROD_FRONTEND_PORT=3000
PROD_FRONTEND_HOST=localhost

# Vite-specific variables (exposed to frontend)
VITE_API_URL=http://localhost:3001/api
VITE_BACKEND_URL=http://localhost:3001/api
VITE_NODE_ENV=development
VITE_ENABLE_LOGGING=true
VITE_ENABLE_DEBUG_MODE=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_OWNER_PANEL=true

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================
# Development
DEV_BACKEND_PORT=3001
DEV_BACKEND_HOST=localhost

# Production
PROD_BACKEND_PORT=3001
PROD_BACKEND_HOST=localhost

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Session Secret (REQUIRED - generate a strong secret for production)
SESSION_SECRET=your-super-secret-session-key-change-in-production

# JWT Secret (REQUIRED - generate a strong secret for production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# General Secret Key
SECRET_KEY=your-super-secret-key-change-in-production

# BCrypt Rounds (higher = more secure but slower)
BCRYPT_ROUNDS=12

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_database_name
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =============================================================================
# SCHEMA CONFIGURATION
# =============================================================================
AUTH_SCHEMA=auth_internal
TEMPLATE_SCHEMA=client_template
SEED_SCHEMA=client_template

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_LIMIT=300

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Comma-separated list of allowed client origins
ALLOWED_CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_LOGGING=true
ENABLE_ANALYTICS=false
ENABLE_OWNER_PANEL=true
ENABLE_DEBUG_MODE=true

# =============================================================================
# UI CONFIGURATION
# =============================================================================
UI_THEME=dark
UI_LANGUAGE=en
UI_PAGE_SIZE=10
UI_ANIMATION_DURATION=300

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_TIMEOUT=10000
API_RETRIES=3

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================
AUTH_TOKEN_KEY=auth_token
AUTH_SESSION_TIMEOUT=86400000
AUTH_REFRESH_THRESHOLD=300000
AUTH_REDIRECT_KEY=auth_return_url

# =============================================================================
# GITHUB ACTIONS / CI/CD OVERRIDES
# =============================================================================
# These variables will be set by GitHub Actions and take precedence
# No need to set these locally - they're for production deployment

# Production overrides (set by GitHub Actions)
# VITE_API_URL=https://your-production-api.com/api
# VITE_BACKEND_URL=https://your-production-api.com/api
# VITE_NODE_ENV=production
# SESSION_SECRET=production-session-secret-from-github-secrets
# JWT_SECRET=production-jwt-secret-from-github-secrets
# POSTGRES_USER=production-db-user-from-github-secrets
# POSTGRES_PASSWORD=production-db-password-from-github-secrets
# POSTGRES_HOST=production-db-host-from-github-secrets
